		"devdoc": {
			"details": "A simplified version of the manufacturing game where Automated Robot Vehicles (ARVs) collect rewards from various job spots. Each job spot contains one job with a varying reward, which is paid in ERC20 tokens when the job is collected.",
			"kind": "dev",
			"methods": {
				"collectJob(bytes4)": {
					"details": "Allows an ARV (msg.sender) to collect the job at a specific job spot. The ARV must provide the correct RFID tag. The ARV will receive the reward in ERC20 tokens.",
					"params": {
						"tag": "The RFID tag of the job spot."
					}
				},
				"depositTokens(uint256)": {
					"details": "Allows the factory owner to deposit ERC20 tokens into the factory for paying rewards."
				},
				"getAllJobSpots()": {
					"details": "Returns an array of all job spot RFID tags."
				},
				"getJobReward(bytes4)": {
					"details": "Returns the reward for a job at a given job spot. If the job has already been collected, the reward will be 0.",
					"params": {
						"tag": "The RFID tag of the job spot to query."
					}
				},
				"initialize()": {
					"details": "Initializes all jobSpots with random rewards. Uses the predefined RFID tags instead of numeric IDs. Can be called again to reset rewards (collectors remain unchanged)."
				},
				"totalRewards()": {
					"details": "Calculates and returns the total rewards across all job spots. This sums up the reward for each job spot, regardless of whether it has been collected."
				},
				"updateAllTags(bytes4[],bytes4[])": {
					"details": "Batch update multiple RFID tags. oldTags[i] will be replaced by newTags[i]."
				},
				"updateTag(bytes4,bytes4)": {
					"details": "Update a single RFID tag for an existing jobSpot."
				},
				"withdrawTokens(uint256)": {
					"details": "Allows the factory owner to withdraw ERC20 tokens from the factory."
				}
			},
			"title": "FactoryFrenzy",
			"version": 1
